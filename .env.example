# Copy to .env and edit. Never commit .env.

# Optional: any OpenAI-compatible chat API. Leave OPENAI_API_KEY empty to get retrieved chunks only.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Database (used by docker compose and Django)
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0

# Optional tuning
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
